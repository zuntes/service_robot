<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:unless value="$(arg use_sim_time)">
        <ros2_control name="RealRobot" type="system">
            <hardware>
                <plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin>
                <param name="left_wheel_name">left_wheel_joint</param>
                <param name="right_wheel_name">right_wheel_joint</param>
                <param name="loop_rate">30</param>
                <param name="device">/dev/ttyACM0</param>
                <param name="baud_rate">115200</param>
                <param name="timeout_ms">1500</param>
                <!-- <param name="enc_counts_per_rev">465</param> -->
            </hardware>
            <joint name="left_wheel_joint">
                <command_interface name="velocity"/>    
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_wheel_joint">
                <command_interface name="velocity"/>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>
    </xacro:unless>

    <xacro:if value="$(arg use_sim_time)">
        <xacro:macro name="friction" params="reference mu">
            <gazebo reference="${reference}">
              <mu1>${mu}</mu1>
              <mu2>${mu}</mu2>
              <kp>1000000.0</kp>
              <kd>100.0</kd>
              <minDepth>0.001</minDepth>
              <maxVel>1.0</maxVel>
            </gazebo>
          </xacro:macro>
        
          <!-- <xacro:friction reference="right_wheel" mu="0.1" />
          <xacro:friction reference="left_wheel" mu="0.1" /> -->
          <xacro:friction reference="caster_front_link" mu="0.01" />
          <xacro:friction reference="caster_rear_link" mu="0.01" />

        <ros2_control name="GazeboSystem" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <joint name="left_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="right_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>
        <!-- <gazebo>
            <plugin name="joint_state_broadcaster" filename="libgazebo_ros_joint_state_publisher.so">
                <ros>
                    <remapping>~/out:=joint_states</remapping>
                    <remapping>/tf:=tf</remapping>
                </ros>
                <update_rate>60</update_rate>
                <joint_name>right_wheel_joint</joint_name>
                <joint_name>left_wheel_joint</joint_name>
            </plugin>
        </gazebo> -->
    </xacro:if>
    
    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find robot_description)/config/ros2_controllers.yaml</parameters>
            <parameters>$(find robot_description)/config/gaz_ros2_ctl_use_sim.yaml</parameters>
        </plugin>
    </gazebo>

</robot>